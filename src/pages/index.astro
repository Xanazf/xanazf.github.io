---
import MainLayout from "@layouts/MainLayout.astro";
import ProjectCard from "@components/cards/ProjectCard.astro";
import SkillCard from "@components/cards/SkillCard.astro";
import Hero from "@components/sections/hero/Hero.astro";
import Experience from "@components/experience/Experience.astro";
import "@styles/pages/main.css";
---

<MainLayout title="Oleksandr Marnov" description="Web Developer & Designer">
  <Hero />

  <h2 class="section-heading reveal" style="--delay: 60ms">
    <span class="section-heading__comment">// </span>Experience
  </h2>
  <div class="px-md sm:px-lg lg:px-xl pb-md">
    <Experience />
  </div>

  <h2 class="section-heading reveal" style="--delay: 60ms">
    <span class="section-heading__comment">// </span>Projects
  </h2>
  <div
    class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-md px-md pb-md sm:px-lg lg:px-xl reveal"
    style="--delay: 100ms"
  >
    <ProjectCard
      projectName="Quickshell"
      projectLink="https://quickshell.org"
    />
    <ProjectCard
      projectName="HeavyLift"
      projectLink="https://github.com/Xanazf/heavylift"
    />
    <ProjectCard
      projectName="Bongopunk"
      projectLink="https://github.com/Xanazf/bongopunk"
    />
  </div>

  <h2 class="section-heading reveal" style="--delay: 60ms">
    <span class="section-heading__comment">// </span>Skills
  </h2>
  <div class="px-md pb-xl sm:px-lg lg:px-xl">
    <SkillCard />
  </div>
</MainLayout>

<style>
  .section-heading {
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #6b7585;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    padding: 2rem 0 8px;
    margin: 0 0 20px;
    padding-inline: var(--space-xl, 2rem);
    font-weight: 400;
  }
  .section-heading__comment {
    color: #2a303c;
  }
</style>
