---
import type { ProjectType } from "@config/_types/ComponentTypes";

export interface Props extends ProjectType {}
const { projectName, projectLink } = Astro.props;
const NDAdata = {
  numberOfWebsites: 6,
};
---
<div class={`project-card pc ${projectName.toLowerCase()}`}>
  {projectName !== "NDA" ? (
    <a href={projectLink} target="_blank" class="pc-link">{projectName}</a>
  ):(
    <p>{NDAdata.numberOfWebsites} websites under NDA</p>
  )}
</div>
