---
const tracks = [
  {
    label: "development",
    color: "amber",
    speed: "45s",
    reverse: false,
    items: [
      "TypeScript",
      "Node.js",
      "Go",
      "React",
      "SolidJS",
      "CSS",
      "Bash",
      "Git",
      "C++",
      "Next.js",
      "SQL",
    ],
  },
  {
    label: "design",
    color: "teal",
    speed: "60s",
    reverse: true,
    items: [
      "Figma",
      "TailwindCSS",
      "MD3",
      "Hero UI",
      "UI/UX",
      "Interactive Media",
    ],
  },
  {
    label: "architecture",
    color: "cyan",
    speed: "38s",
    reverse: false,
    items: [
      "Kubernetes",
      "Docker",
      "Linux",
      "CI/CD",
      "Caddy",
      "Nginx",
      "Traefik",
      "Redis",
      "MongoDB",
      "GCP",
      "Prometheus",
      "Grafana",
      "ELK Stack",
      "REST API",
      "Airflow",
    ],
  },
];
---

<div class="skills reveal" style="--delay: 80ms">
  {tracks.map((track) => (
    <div class="skill-row">
      <span class={`skill-label skill-label--${track.color}`}>
        {track.label}
      </span>
      <div class="marquee-wrap" title="hover to pause">
        <div
          class={`marquee ${track.reverse ? "reverse" : ""}`}
          style={`animation-duration: ${track.speed};`}
        >
          {[...track.items, ...track.items].map((item, i) => (
            i % track.items.length === track.items.length - 1
              ? <span class={`skill-item skill-item--${track.color}`}>{item}</span>
              : <>
                  <span class={`skill-item skill-item--${track.color}`}>{item}</span>
                  <span class="skill-sep">·</span>
                </>
          ))}
        </div>
      </div>
    </div>
  ))}
</div>

<style>
  .skills {
    display: flex;
    flex-direction: column;
    gap: 0;
    width: 100%;
  }

  /* === MARQUEE — from marquee.html === */
  .skill-row {
    display: flex;
    align-items: center;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    overflow: hidden;
  }
  .skill-row:last-child {
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .skill-label {
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 14px 16px;
    white-space: nowrap;
    flex-shrink: 0;
    width: 110px;
    border-right: 1px solid rgba(255, 255, 255, 0.05);
  }
  .skill-label--amber {
    color: #ffb86c;
  }
  .skill-label--teal {
    color: #72f1b8;
  }
  .skill-label--cyan {
    color: #67cdcc;
  }

  .marquee-wrap {
    overflow: hidden;
    flex: 1;
    padding: 14px 0;
    mask-image: linear-gradient(
      90deg,
      transparent,
      black 5%,
      black 95%,
      transparent
    );
    -webkit-mask-image: linear-gradient(
      90deg,
      transparent,
      black 5%,
      black 95%,
      transparent
    );
  }
  .marquee-wrap:hover .marquee {
    animation-play-state: paused;
  }

  .marquee {
    display: inline-flex;
    gap: 18px;
    padding-right: 18px;
    animation: marquee-scroll 45s linear infinite;
    white-space: nowrap;
  }
  .marquee.reverse {
    animation-direction: reverse;
  }

  @keyframes marquee-scroll {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  .skill-item {
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .skill-item--amber {
    color: #8a7060;
  }
  .skill-item--teal {
    color: #507a6a;
  }
  .skill-item--cyan {
    color: #4a7070;
  }

  .skill-sep {
    color: rgba(255, 255, 255, 0.1);
  }

  /* Brighten on wrap hover */
  .marquee-wrap:hover .skill-item--amber {
    color: #ffb86c;
  }
  .marquee-wrap:hover .skill-item--teal {
    color: #72f1b8;
  }
  .marquee-wrap:hover .skill-item--cyan {
    color: #67cdcc;
  }
</style>
