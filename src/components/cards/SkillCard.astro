---
import { Icon } from "astro-icon/components";

const skills: Record<string, Array<{ label: string; icon: string }>> = {
  development: [
    { label: "TypeScript", icon: "logos:typescript-icon" },
    { label: "Node.js", icon: "logos:nodejs-icon" },
    { label: "CSS", icon: "logos:css-3" },
    { label: "Bash", icon: "mdi:bash" },
    { label: "Git", icon: "mdi:git" },
    { label: "Go", icon: "logos:go" },
    { label: "React", icon: "logos:react" },
    { label: "SolidJS", icon: "logos:solidjs-icon" },
  ],
  design: [
    { label: "Figma", icon: "logos:figma" },
    { label: "MD3", icon: "logos:material-ui" },
    { label: "Hero UI", icon: "simple-icons:heroui" },
    { label: "TailwindCSS", icon: "logos:tailwindcss-icon" },
  ],
  architecture: [
    { label: "Vercel", icon: "logos:vercel-icon" },
    { label: "Linux", icon: "logos:linux-tux" },
    { label: "REST API", icon: "mdi:api" },
    { label: "CI/CD", icon: "mdi:repeat" },
    { label: "Caddy", icon: "simple-icons:caddy" },
    { label: "Nginx", icon: "logos:nginx" },
    { label: "Traefik", icon: "simple-icons:traefikproxy" },
    { label: "Redis", icon: "logos:redis" },
    { label: "MongoDB", icon: "logos:mongodb-icon" },
    { label: "Postman", icon: "logos:postman-icon" },
  ],
};
---

<div class="grid grid-cols-1 md:grid-cols-3 gap-md">
  {Object.entries(skills).map(([group, list], i) => (
    <section
      class="skill-panel reveal"
      style={`--delay: ${i * 80}ms`}
      aria-labelledby={`skill-${group}`}
    >
      <div class="skill-label" id={`skill-${group}`}>
        {group}
      </div>
      <div class="skill-tags">
        {list.map((s) => (
          <span class="skill-tag" title={s.label}>
            <span class="skill-icon" aria-hidden="true">
              <Icon name={s.icon} width="1.1em" height="1.1em" />
            </span>
            <span class="skill-name">{s.label}</span>
          </span>
        ))}
      </div>
    </section>
  ))}
</div>

<style>
  .skill-panel {
    background: rgba(24, 21, 31, 0.55);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 4px;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    transition: border-color 0.35s ease;
  }
  .skill-panel:hover {
    border-color: rgba(255, 184, 108, 0.14);
  }

  .skill-label {
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #6b7585;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    padding-bottom: 8px;
  }

  .skill-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .skill-tag {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 11px;
    color: #d8d4ce;
    padding: 4px 9px;
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.02);
    transition:
      border-color 0.2s ease,
      color 0.2s ease,
      text-shadow 0.2s ease;
    cursor: default;
    white-space: nowrap;
  }
  .skill-tag:hover {
    border-color: rgba(255, 184, 108, 0.35);
    color: #ffb86c;
    text-shadow: 0 0 8px rgba(255, 184, 108, 0.4);
  }

  .skill-icon {
    display: flex;
    align-items: center;
    opacity: 0.85;
  }
  .skill-tag:hover .skill-icon {
    opacity: 1;
  }
</style>
