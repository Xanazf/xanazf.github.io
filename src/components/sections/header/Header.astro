---
import { Icon } from "astro-icon/components";

import Nav from "@components/nav/Nav.astro";
---

<header id="header" class="header flex mx-auto rounded-lg header-responsive">
  <div class="flex justify-center items-center"><Icon name="xnzf-logo" /></div>
  <div class="right-section">
    <Nav />
  </div>
</header>

<style>
  .header-responsive {
    height: max-content;
    width: max-content;
  }
  @media (min-width: 65rem) {
    .header-responsive {
      width: 100%;
    }
  }
</style>
