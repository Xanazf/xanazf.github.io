---
const roles = [
  {
    period: "2025 – now",
    title: "Senior DevOps Engineer",
    company: "Apptie OU",
    tag: "DevOps",
    desc: "Cloud solutions, IDP, custom IaC geospatial & email servers.",
  },
  {
    period: "2024 – 2025",
    title: "Full Stack · Platform Engineer",
    company: "Freelance",
    tag: "Platform",
    desc: "Cloud infrastructure across multiple business domains.",
  },
  {
    period: "2022 – 2024",
    title: "Senior Platform Engineer",
    company: "Confidential",
    tag: "Platform",
    desc: "500k+ RPM APIs, 2 CRM systems, real-time Telegram integrations.",
  },
  {
    period: "2022",
    title: "Integration Engineer",
    company: "Pragmatic Play",
    tag: "Integration",
    desc: "Technical integration of gaming software with tier-1 clients.",
  },
  {
    period: "2021",
    title: "DevOps · L3 Support Engineer",
    company: "NewAge IO",
    tag: "DevOps",
    desc: "Cloud infra support, Bash/JS automation, Kubernetes, ELK stack.",
  },
];
---

<div class="experience reveal" style="--delay: 80ms">
  {roles.map((role) => (
    <div class="exp-item">
      <span class="exp-period">{role.period}</span>
      <div class="exp-body">
        <div class="exp-title">{role.title}</div>
        <div class="exp-company">{role.company}</div>
      </div>
      <span class="exp-tag">{role.tag}</span>
    </div>
  ))}
</div>

<style>
  .experience {
    width: 100%;
    padding-left: 16px;
  }

  .exp-item {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 16px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    position: relative;
    cursor: default;
    transition:
      padding-left 0.35s cubic-bezier(0.4, 0, 0.2, 1),
      border-color 0.35s ease;
  }

  .exp-item::before {
    content: "";
    position: absolute;
    left: -12px;
    top: 50%;
    width: 6px;
    height: 6px;
    background: #ffb86c;
    border-radius: 50%;
    transform: translateY(-50%) scale(0);
    transition: transform 0.25s ease;
    box-shadow: 0 0 7px #ffb86c;
  }

  .exp-item:hover {
    padding-left: 12px;
    border-bottom-color: rgba(255, 184, 108, 0.3);
  }
  .exp-item:hover::before {
    transform: translateY(-50%) scale(1);
  }
  .exp-item:hover .exp-title {
    color: #ffb86c;
    text-shadow: 0 0 8px rgba(255, 184, 108, 0.4);
  }

  .exp-period {
    font-size: 11px;
    color: #6b7585;
    width: 76px;
    flex-shrink: 0;
    font-variant-numeric: tabular-nums;
  }

  .exp-body {
    flex: 1;
    min-width: 0;
  }

  .exp-title {
    font-size: 0.9rem;
    font-weight: 600;
    color: #d8d4ce;
    margin-bottom: 2px;
    transition:
      color 0.25s ease,
      text-shadow 0.25s ease;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .exp-company {
    font-size: 11px;
    color: #6b7585;
  }

  .exp-tag {
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #ffb86c;
    padding: 3px 8px;
    border: 1px solid rgba(255, 184, 108, 0.3);
    border-radius: 2px;
    background: rgba(255, 184, 108, 0.06);
    flex-shrink: 0;
  }
</style>
