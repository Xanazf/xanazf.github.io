---
import { Icon } from "astro-icon/components";
---
<div class="mt-md">
  <ul class="flex justify-between gap-xl m-0 p-0" style="list-style: none;">
    <li class="color-onsurface" style="font-size: 2rem; transition: transform 0.2s; cursor: pointer;" onmouseover="this.style.transform='scale(1.1)'" onmouseout="this.style.transform='scale(1)'">
      <a href="https://github.com/Xanazf" target="_blank" style="color: inherit;"><Icon name="github"/></a>
    </li>
    <li style="font-size: 2rem; color: hsl(199 100% 63%); transition: transform 0.2s; cursor: pointer;" onmouseover="this.style.transform='scale(1.1)'" onmouseout="this.style.transform='scale(1)'">
      <a href="https://linkedin.com/in/nautylus" target="_blank" style="color: inherit;"><Icon name="linkedin"/></a>
    </li>
    <li style="font-size: 2rem; color: hsl(15 100% 63%); transition: transform 0.2s; cursor: pointer;" onmouseover="this.style.transform='scale(1.1)'" onmouseout="this.style.transform='scale(1)'">
      <a href="mailto:hotdamnsucka@gmail.com" style="color: inherit;"><Icon name="google"/></a>
    </li>
    <li class="color-onsurface" style="font-size: 2rem; transition: transform 0.2s; cursor: pointer;" onmouseover="this.style.transform='scale(1.1)'" onmouseout="this.style.transform='scale(1)'">
      <a href="https://codepen.io/Xanazf" target="_blank" style="color: inherit;"><Icon name="codepen"/></a>
    </li>
  </ul>
</div>
