---
import { Icon } from "astro-icon/components";

import Nav from "@components/nav/Nav.astro";
import Console from "@components/nav/Console.astro";
---

<header id="header" class="header flex mx-auto rounded-lg header-responsive">
  <div class="left-section">
    <Console />
  </div>
  <div class="right-section">
    <div class="flex justify-center items-center logo-wrap">
      <Icon name="xnzf-logo" />
    </div>
    <Nav />
  </div>
</header>

<style>
  .header-responsive {
    height: max-content;
    width: max-content;
  }
  header.header {
    position: sticky;
    bottom: 0;
    z-index: 10;
    display: flex;
    width: 100%;
    overflow: hidden;
    border-radius: 0;
    padding-inline: 1rem;
    border-top: 1px solid rgba(255, 184, 108, 0.1);
    background: rgba(17, 16, 26, 0.75);
    backdrop-filter: blur(18px) saturate(130%);
  }
  .left-section {
    width: 50%;
    position: relative;
    z-index: 1;
  }
  .right-section {
    width: 50%;
    display: flex;
    position: relative;
    z-index: 1;
  }
  .logo-wrap {
    opacity: 0.7;
    transition: opacity 0.25s ease;
    &:hover {
      opacity: 1;
    }
  }
  @media (min-width: 65rem) {
  }
</style>
